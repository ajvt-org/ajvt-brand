{
  "name": "ajvt-brand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visual identity, document, presentation and social templates for AJVT — رابطة شباب قرية التاكلالت",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:tokens && npm run build:logos && npm run build:crests && npm run build:guidelines && npm run build:docs && npm run build:cards",
    "build:tokens": "node tools/build-tokens.mjs",
    "build:logos": "node tools/build-logos.mjs",
    "build:crests": "node tools/build-team-crests.mjs",
    "build:guidelines": "node tools/build-guidelines.mjs",
    "build:docs": "node tools/build-docs.mjs",
    "build:decks": "node tools/build-decks.mjs",
    "build:cards": "node tools/build-cards.mjs",
    "studio": "node tools/studio.mjs",
    "check": "node tools/check.mjs",
    "check:fonts": "node tools/check.mjs --only=fonts",
    "font:set": "node tools/font-set.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('logos/dist',{recursive:true,force:true})\"",
    "fonts:fetch": "node tools/fonts-fetch.mjs",
    "arch": "node tools/arch.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "harfbuzzjs": "^1.6.1",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.49.1",
    "sharp": "^0.33.5",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.1.2"
  }
}
